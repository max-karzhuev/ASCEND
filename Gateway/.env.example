# All values below are placeholders. Never commit a real .env file.
ASCEND_AUTH_TOKEN=REPLACE_WITH_A_RANDOM_32_BYTE_TOKEN
HOST=127.0.0.1
PORT=8787
STATE_DIR=.gateway-state
REQUESTS_PER_MINUTE=10
REQUESTS_PER_DAY=100
